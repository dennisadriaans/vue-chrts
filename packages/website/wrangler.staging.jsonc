{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuxt-charts-staging",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-12-16",
  "keep_vars": true,
  "assets": {
    "directory": "./.output/public/",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "nuxt-charts-staging"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "a1a534a1-35d9-4009-8e20-d46b69d93bcd"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "c7b9928ffe13474e9a0f5642e0234b51"
    }
  ],
  "placement": { "mode": "smart" },
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NUXT_PUBLIC_LOCK_CODE": "8801"
  }
}
