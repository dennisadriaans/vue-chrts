{
  "name": "website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "deploy": "NODE_OPTIONS='--max-old-space-size=12192' npm run build && npx wrangler deploy --domains nuxtcharts.com",
    "deploy:staging": "NODE_OPTIONS='--max-old-space-size=12192' npm run build && npx wrangler deploy --config wrangler.staging.jsonc --domains test.nuxtcharts.com",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "screenshot": "node screenshot.js",
    "cf:secrets": "./scripts/cf-secrets-from-dotenv.sh .env",
    "zip:lib": "node ./ziplib.js",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:prod": "playwright test tests/e2e/checkout/",
    "test:e2e:checkout": "playwright test tests/e2e/checkout/",
    "test:a11y": "vitest run -t 'accessibility|a11y'"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.70",
    "@iconify-json/simple-icons": "^1.2.55",
    "@iconify-json/vscode-icons": "^1.2.32",
    "@libsql/client": "^0.15.15",
    "@nuxt/content": "^3.8.2",
    "@nuxt/image": "^1.11.0",
    "@nuxt/scripts": "0.11.5",
    "@nuxt/ui": "^4.5.0",
    "@nuxthub/core": "0.10.1",
    "@nuxtjs/turnstile": "1.0.0",
    "@octokit/rest": "^21.1.1",
    "@unhead/vue": "^2.0.19",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue-email/components": "^0.0.21",
    "@vue-email/render": "^0.0.9",
    "@vue-email/tailwind": "^0.2.0",
    "@vue/shared": "^3.5.22",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.4.1",
    "dayjs": "^1.11.18",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.5.1",
    "hast-util-to-html": "^9.0.5",
    "lowlight": "^3.3.0",
    "nanoid": "^6.0.0",
    "nuxt": "4.3.0",
    "nuxt-auth-utils": "^0.5.25",
    "nuxt-charts": "workspace:*",
    "nuxt-charts-next": "workspace:*",
    "nuxt-shiki": "0.3.1",
    "perfect-debounce": "^2.1.0",
    "pkg-types": "^2.3.0",
    "playwright": "^1.58.0",
    "shiki": "^3.23.0",
    "stripe": "^17.7.0",
    "swiper": "^11.2.10",
    "use-email": "^0.0.8",
    "vue": "^3.5.22",
    "vue-chrts": "workspace:*",
    "vue-github-button": "^3.1.3",
    "vue-router": "^4.6.3",
    "vue-sonner": "^1.3.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.6",
    "@nuxt/test-utils": "^3.20.1",
    "@playwright/test": "^1.58.1",
    "@types/archiver": "^6.0.3",
    "@types/inquirer": "^9.0.9",
    "@types/pluralize": "^0.0.33",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.11.0",
    "chalk": "^5.6.2",
    "commander": "^11.1.0",
    "drizzle-kit": "^0.29.1",
    "eslint": "^9.38.0",
    "happy-dom": "^20.0.11",
    "inquirer": "^9.3.8",
    "motion-v": "1.7.4",
    "pluralize": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^3.3.5",
    "wrangler": "^4.54.0"
  }
}
