# Session
NUXT_SESSION_PASSWORD=
NUXT_HUB_PROJECT_KEY=

# Admin & notifications
# Email of the sole admin (gates /admin routes + admin API). Also exposed to the
# client via NUXT_PUBLIC_ADMIN_EMAIL for UI gating only — server routes re-check.
NUXT_ADMIN_EMAIL=
NUXT_PUBLIC_ADMIN_EMAIL=
# Recipient for internal notification emails (new customer, feedback, errors).
NUXT_NOTIFICATION_EMAIL=

# Affiliate program
# Comma-separated allowlist of emails permitted to join the affiliate program.
# Server-enforced; also exposed via NUXT_PUBLIC_AFFILIATE_ALLOWED_EMAILS for UI gating.
NUXT_AFFILIATE_ALLOWED_EMAILS=
NUXT_PUBLIC_AFFILIATE_ALLOWED_EMAILS=
# Verified "nuxt" affiliate secrets: Stripe Connect account id (acct_...) and
# contact email (used for reverse-charge invoicing).
NUXT_AFFILIATE_NUXT_ACCOUNT_ID=
NUXT_AFFILIATE_NUXT_EMAIL=

# Stripe
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NUXT_STRIPE_CONNECT_CLIENT_ID=

# Invoicing (NL company details for reverse-charge commission invoices)
NUXT_INVOICING_COMPANY_NAME=
NUXT_INVOICING_COMPANY_VAT=
NUXT_INVOICING_COMPANY_ADDRESS=

# GitHub
NUXT_GITHUB_TOKEN=
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Google OAuth
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Email (Plunk)
NUXT_PLUNK_API_TOKEN=

# Analytics
NUXT_GA_API_SECRET=
NUXT_PUBLIC_GA_MEASUREMENT_ID=
NUXT_PUBLIC_GOOGLE_TAG_MANAGER=

# Turnstile
NUXT_TURNSTILE_SECRET_KEY=
