{
  "name": "nuxt-charts",
  "version": "3.1.0",
  "description": "Beautiful chart and D3 map components for Nuxt — Area, Bar, Line, Donut, Bubble, Radar, Radial Bar, Funnel, Sankey, Candlestick, Status Tracker, Heatmap, Dotted Map, TopoJSON Map",
  "license": "MIT",
  "author": "Dennis Adriaansen <adriaansendennis@gmail.com>",
  "homepage": "https://nuxtcharts.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisadriaans/vue-chrts.git",
    "directory": "packages/nuxt-charts-next"
  },
  "bugs": {
    "url": "https://github.com/dennisadriaans/vue-chrts/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "vue",
    "charts",
    "chart",
    "dataviz",
    "visualization",
    "vccs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    },
    "./types": {
      "types": "./dist/runtime/types.d.ts",
      "import": "./dist/runtime/types.js",
      "default": "./dist/runtime/types.js"
    },
    "./enums": {
      "types": "./dist/runtime/enums.d.ts",
      "import": "./dist/runtime/enums.js",
      "default": "./dist/runtime/enums.js"
    },
    "./spec": {
      "types": "./dist/runtime/spec/index.d.ts",
      "import": "./dist/runtime/spec/index.js",
      "default": "./dist/runtime/spec/index.js"
    },
    "./maps": {
      "types": "./dist/runtime/maps.d.ts",
      "import": "./dist/runtime/maps.js",
      "default": "./dist/runtime/maps.js"
    },
    "./components": {
      "types": "./dist/runtime/components/index.d.ts",
      "import": "./dist/runtime/components/index.js",
      "default": "./dist/runtime/components/index.js"
    },
    "./theme.css": "./dist/runtime/assets/theme.css",
    "./components.css": "./dist/runtime/assets/components.css"
  },
  "main": "./dist/module.mjs",
  "module": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build && node scripts/clean-declarations.mjs",
    "dev": "nuxi dev playground",
    "build": "nuxt-module-build build && node scripts/clean-declarations.mjs",
    "build:playground": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "node ../../tools/release.mjs --package nuxt-charts",
    "lint": "eslint .",
    "typecheck": "pnpm run test:types",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "release:dry": "node ../../tools/release.mjs --package nuxt-charts --dry-run"
  },
  "dependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-specification": "^1.0.5",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "motion-v": "^2.3.0",
    "topojson-client": "^3.1.0",
    "vccs": "^0.5.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/eslint": "^1.7.1",
    "@nuxt/eslint-config": "^1.13.0",
    "@nuxt/kit": "^4.3.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.3.0",
    "@nuxt/test-utils": "^4.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "latest",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.2",
    "happy-dom": "^20.10.6",
    "nuxt": "^4.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18",
    "vue": "^3.5.42",
    "vue-tsc": "^3.2.4"
  },
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
