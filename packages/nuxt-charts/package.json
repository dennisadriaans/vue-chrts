{
  "name": "nuxt-charts",
  "version": "2.2.1",
  "description": "Nuxt Charts module (Unovis / vue-chrts).",
  "license": "MIT",
  "author": "Dennis Adriaansen <adriaansendennis@gmail.com>",
  "homepage": "https://nuxtcharts.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisadriaans/vue-chrts.git",
    "directory": "packages/nuxt-charts"
  },
  "bugs": {
    "url": "https://github.com/dennisadriaans/vue-chrts/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "vue",
    "charts",
    "chart",
    "dataviz",
    "visualization",
    "unovis"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "module": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "build": "nuxt-module-build build",
    "build:playground": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "node ../../tools/release.mjs --package nuxt-charts-legacy",
    "lint": "eslint .",
    "typecheck": "pnpm run test:types",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "test:e2e:prod": "NUXT_CHARTS_E2E_MODE=prod playwright test",
    "test:e2e:all": "./scripts/run-e2e.sh",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "vue-chrts": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/eslint": "^1.7.1",
    "@nuxt/eslint-config": "^1.13.0",
    "@nuxt/kit": "^4.3.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.3.0",
    "@nuxt/test-utils": "^3.23.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "latest",
    "eslint": "^9.39.2",
    "nuxt": "^4.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "packageManager": "pnpm@10.33.0"
}
