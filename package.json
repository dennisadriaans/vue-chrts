{
  "version": "0.0.0",
  "name": "vue-chrts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:vue": "turbo run build --filter=vue-chrts",
    "build:nuxt": "turbo run build --filter=nuxt-charts",
    "build:nuxt-legacy": "turbo run build --filter=nuxt-charts-legacy",
    "dev": "turbo run dev",
    "dev:nuxt": "turbo run dev --filter=nuxt-charts",
    "dev:nuxt-legacy": "turbo run dev --filter=nuxt-charts-legacy",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:release": "node --test tools/release/release.test.mjs",
    "release": "node tools/release.mjs",
    "release:dry": "node tools/release.mjs --dry-run",
    "release:vue": "node tools/release.mjs --package vue-chrts",
    "release:nuxt": "node tools/release.mjs --package nuxt-charts",
    "release:nuxt-legacy": "node tools/release.mjs --package nuxt-charts-legacy"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "turbo": "^2.5.5"
  }
}
