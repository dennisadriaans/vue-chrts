{
  "version": "0.0.0",
  "name": "vue-chrts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:vue": "turbo run build --filter=vue-chrts",
    "build:site": "turbo run build --filter=website",
    "build:nuxt": "turbo run build --filter=nuxt-charts",
    "build:nuxt-v2": "turbo run build --filter=nuxt-charts-v2",
    "dev": "turbo run dev",
    "dev:nuxt": "turbo run dev --filter=nuxt-charts",
    "dev:nuxt-v2": "turbo run dev --filter=nuxt-charts-v2",
    "dev:site": "turbo run dev --filter=website",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "release:vue": "turbo run release --filter=vue-chrts",
    "release:nuxt": "turbo run release --filter=nuxt-charts",
    "sync-versions": "node scripts/sync-versions.js"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "turbo": "^2.5.5"
  }
}
